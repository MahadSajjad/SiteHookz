  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "rimraf": "^6.0.0",
    "@sitehookz/typescript-config": "workspace:*"
  }
}

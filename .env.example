# Database
DATABASE_URL=postgresql://sitehookz:sitehookz_dev@localhost:5432/sitehookz_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
REFRESH_TOKEN_EXPIRY=7d

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Tenant
TENANT_BASE_DOMAIN=sitehookz.com
TENANT_RESOLUTION_MODE=development
DEV_TENANT_HEADER_ENABLED=true

# API
API_PORT=3000
API_PREFIX=api/v1
NODE_ENV=development

# Frontend URLs
EDUCATION_WEB_URL=http://localhost:5173
MARKETING_WEB_URL=http://localhost:5174
PLATFORM_ADMIN_WEB_URL=http://localhost:5175

# Email (development)
MAIL_ADAPTER=console

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10
